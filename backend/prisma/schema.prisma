generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  address       String
  city          String
  country       String
  phone         String
  description   String?
  property_type String // boutique, resort, business, etc.
  amenities     Json
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  rooms         Room[]
  bookings      Booking[]
  users         User[]
  pricing_rules PricingRule[]

  @@index([email])
}

model Room {
  id                String   @id @default(uuid())
  hotel_id          String
  room_number       String
  room_type         String // Single, Double, Suite, Deluxe
  capacity_adults   Int
  capacity_children Int
  bed_type          String // King, Queen, Twin, Single
  base_price        Decimal  @db.Decimal(10, 2)
  current_price     Decimal  @db.Decimal(10, 2)
  amenities         Json
  description       String?
  photos            Json
  floor             Int?
  view_type         String? // Ocean, City, Garden, Pool
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  hotel         Hotel              @relation(fields: [hotel_id], references: [id])
  bookings      Booking[]
  price_history RoomPriceHistory[]
  availability  RoomAvailability[]

  @@index([hotel_id])
  @@index([room_type])
  @@index([is_active])
  @@unique([hotel_id, room_number])
}

model Booking {
  id                  String   @id @default(uuid())
  hotel_id            String
  room_id             String
  booking_reference   String   @unique
  guest_name          String
  guest_email         String
  guest_phone         String
  check_in            DateTime
  check_out           DateTime
  nights              Int
  adults              Int
  children            Int      @default(0)
  base_price          Decimal  @db.Decimal(10, 2)
  total_price         Decimal  @db.Decimal(10, 2)
  discount_applied    Decimal  @db.Decimal(10, 2) @default(0)
  status              String // pending, confirmed, checked_in, checked_out, cancelled
  payment_status      String // pending, paid, refunded, failed
  payment_method      String?
  booking_source      String // direct, booking.com, airbnb, expedia, walk_in, phone
  special_requests    String?
  cancellation_reason String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  hotel Hotel @relation(fields: [hotel_id], references: [id])
  room  Room  @relation(fields: [room_id], references: [id])

  @@index([hotel_id])
  @@index([room_id])
  @@index([check_in])
  @@index([check_out])
  @@index([status])
  @@index([booking_source])
  @@index([created_at])
}

model RoomAvailability {
  id           String   @id @default(uuid())
  room_id      String
  date         DateTime @db.Date
  is_available Boolean  @default(true)
  block_reason String? // maintenance, reserved, event
  price        Decimal  @db.Decimal(10, 2)

  room Room @relation(fields: [room_id], references: [id])

  @@unique([room_id, date])
  @@index([date])
  @@index([is_available])
}

model RoomPriceHistory {
  id              String   @id @default(uuid())
  room_id         String
  date            DateTime @db.Date
  base_price      Decimal  @db.Decimal(10, 2)
  suggested_price Decimal  @db.Decimal(10, 2)
  actual_price    Decimal  @db.Decimal(10, 2)
  occupancy_rate  Decimal  @db.Decimal(5, 2)
  demand_score    Decimal  @db.Decimal(5, 2)
  was_booked      Boolean  @default(false)
  created_at      DateTime @default(now())

  room Room @relation(fields: [room_id], references: [id])

  @@index([room_id, date])
  @@index([date])
}

model PricingRule {
  id                      String   @id @default(uuid())
  hotel_id                String
  min_price               Decimal  @db.Decimal(10, 2)
  max_price               Decimal  @db.Decimal(10, 2)
  strategy                String // conservative, moderate, aggressive
  enable_dynamic_pricing  Boolean  @default(true)
  weekend_multiplier      Decimal  @db.Decimal(3, 2) @default(1.2)
  last_minute_discount    Decimal  @db.Decimal(3, 2) @default(0.9)
  early_bird_discount     Decimal  @db.Decimal(3, 2) @default(0.85)
  length_of_stay_discount Json // {7: 0.9, 14: 0.85, 30: 0.8}
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  hotel Hotel @relation(fields: [hotel_id], references: [id])

  @@index([hotel_id])
}

model User {
  id            String   @id @default(uuid())
  hotel_id      String
  email         String   @unique
  password_hash String
  full_name     String
  role          String // owner, manager, front_desk, housekeeping, accountant
  is_active     Boolean  @default(true)
  last_login    DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  hotel Hotel @relation(fields: [hotel_id], references: [id])

  @@index([hotel_id])
  @@index([email])
  @@index([role])
}

model DashboardMetrics {
  id                  String   @id @default(uuid())
  hotel_id            String
  date                DateTime @db.Date
  total_revenue       Decimal  @db.Decimal(10, 2)
  occupancy_rate      Decimal  @db.Decimal(5, 2)
  adr                 Decimal  @db.Decimal(10, 2) // Average Daily Rate
  revpar              Decimal  @db.Decimal(10, 2) // Revenue Per Available Room
  total_bookings      Int
  cancelled_bookings  Int
  no_shows            Int
  average_lead_time   Int
  average_length_stay Decimal  @db.Decimal(3, 1)
  created_at          DateTime @default(now())

  @@unique([hotel_id, date])
  @@index([hotel_id])
  @@index([date])
}

model CompetitorPrice {
  id       String   @id @default(uuid())
  hotel_id String
  date     DateTime @db.Date
  price    Decimal  @db.Decimal(10, 2)

  @@index([hotel_id, date])
}

model Event {
  id               String   @id @default(uuid())
  hotel_id         String
  name             String
  start_date       DateTime @db.Date
  end_date         DateTime @db.Date
  price_multiplier Decimal  @db.Decimal(3, 2)

  @@index([hotel_id, start_date, end_date])
}
